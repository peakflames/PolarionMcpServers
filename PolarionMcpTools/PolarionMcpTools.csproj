<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal query-builder / guard helpers to the test project so the
         Lucene-containment and SQL-guard logic can be unit-tested directly. -->
    <InternalsVisibleTo Include="PolarionRemoteMcpServer.Tests" />
    <!-- Expose the shared query helpers to the REST server so its endpoints apply the
         same containment checks as the MCP tool instead of a divergent copy. -->
    <InternalsVisibleTo Include="PolarionRemoteMcpServer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Swap to ProjectReference for local debugging; revert to PackageReference for release -->
    <PackageReference Include="Polarion" Version="0.3.8" />
    <!-- <ProjectReference Include="..\..\PolarionApiClient\src\Polarion\Polarion.csproj" /> -->
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Routing.Abstractions" Version="2.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
